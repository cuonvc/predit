# Dependencies
node_modules/
.pnp
.pnp.js

# Production & Build outputs
dist/
dist-ssr/
build/
out/
*.local

# Tauri & Rust build artifacts
src-tauri/target/
src-tauri/gen/
**/target/
Cargo.lock.bak

# Large Sidecar Executables (Managed by externalBin, should be downloaded or built locally)
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
*.exe

# Large AI Model Weights (GGML / GGUF Whisper weights, e.g. ggml-large-v3-turbo-q5_0.bin)
src-tauri/resources/models/*
!src-tauri/resources/models/.gitkeep
*.bin
*.gguf

# Environment variables & API credentials (e.g. Groq / Cloud API keys)
.env
.env.*
!.env.example
*.env

# Temporary Media Processing & Render Outputs
temp/
tmp/
*.tmp
*.ass
*.srt
*.vtt
*.wav
*.mp3
*.mp4
*.mkv
*.webm

# Package Manager Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs & Code Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

