{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Predit",
  "version": "1.0.0",
  "identifier": "com.predit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Predit — Bilingual AI Video Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/fonts/*",
      "resources/models/*"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/whisper-cli"
    ]
  }
}
